# =========================================
# IBKR connection
# =========================================
IBKR_HOST=127.0.0.1
IBKR_PORT=4002              # 4002 = paper, 4001 = live
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=DU0000000      # paper account number (DU prefix)

# =========================================
# Live trading safety (belt + suspenders)
# =========================================
# MUST be true AND IBKR_PORT=4001 for the bot to allow live orders.
LIVE_TRADING=false
# Set true to immediately trip the kill switch on startup.
KILL_SWITCH=false

# =========================================
# Database
# =========================================
DATABASE_URL=postgresql+asyncpg://tradingbot:tradingbot@localhost:5432/tradingbot
REDIS_URL=redis://localhost:6379/0

# =========================================
# Telegram
# =========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================================
# Web API
# =========================================
WEB_API_HOST=0.0.0.0
WEB_API_PORT=8000
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_API_SECRET_KEY=
# Initial admin user bootstrapped on first run.
WEB_ADMIN_USERNAME=admin
# Set this in the deployment environment, not in committed files.
WEB_ADMIN_PASSWORD=

# =========================================
# Logging
# =========================================
LOG_LEVEL=INFO
LOG_FORMAT=json             # json | console

# =========================================
# Observability (optional)
# =========================================
SENTRY_DSN=
