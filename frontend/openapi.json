    "/api/me/totp/enroll": {
      "post": {
        "tags": [
          "me"
        ],
        "summary": "Totp Enroll",
        "description": "Generate a fresh TOTP secret and return it + a provisioning URI.\n\nThe secret is NOT persisted yet. The client must immediately call\nPOST /api/me/totp/verify with the secret AND a valid code to\ncommit it.",
        "operationId": "totp_enroll_api_me_totp_enroll_post",
        "parameters": [
          {
            "name": "tradingbot_session",
            "in": "cookie",
            "required": false,
            "schema": {
