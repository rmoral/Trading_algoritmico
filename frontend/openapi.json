  "components": {
    "schemas": {
      "ActiveAssetResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time",
            "title": "Effective From"
          },
          "effective_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective To"
          },
          "set_by": {
            "type": "string",
            "title": "Set By"
          }
        },
        "type": "object",
        "required": [
          "id",
          "symbol",
          "effective_from",
          "effective_to",
          "set_by"
        ],
        "title": "ActiveAssetResponse",
        "description": "Wire format for the current active asset selection."
      },
      "BotStatusResponse": {
        "properties": {
          "connection_state": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected",
              "unknown"
            ],
            "title": "Connection State"
          },
          "kill_switch_tripped": {
            "type": "boolean",
            "title": "Kill Switch Tripped"
          },
          "kill_switch_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kill Switch Reason"
          },
          "open_position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OpenPositionResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "today_pnl": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PnLResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "connection_state",
          "kill_switch_tripped",
          "kill_switch_reason",
          "open_position",
          "today_pnl"
        ],
        "title": "BotStatusResponse",
        "description": "High-level snapshot for the dashboard poll endpoint."
      },
      "ConfigPolicyPayload": {
        "properties": {
          "account_equity_target_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Account Equity Target Usd"
          },
          "max_position_size_usd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Max Position Size Usd"
          },
          "stop_loss_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Stop Loss Pct"
          },
          "min_profit_per_trade_usd": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Min Profit Per Trade Usd"
          },
          "max_profit_per_trade_usd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Max Profit Per Trade Usd"
          },
          "min_r_multiple": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 1.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Min R Multiple"
          },
          "max_commission_pct_of_target": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 20.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Max Commission Pct Of Target"
          },
          "sr_strong_threshold": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Sr Strong Threshold"
          },
          "sr_weak_threshold": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Sr Weak Threshold"
          },
          "sr_partial_entry_pct": {
            "type": "integer",
            "exclusiveMaximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Sr Partial Entry Pct"
          },
          "sr_level_tolerance_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Sr Level Tolerance Pct"
          },
          "sr_lookback_minutes": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 30.0,
            "title": "Sr Lookback Minutes"
          },
          "sr_pivot_window": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Sr Pivot Window"
          },
          "trend_change_lookback_minutes": {
            "type": "integer",
            "maximum": 480.0,
            "minimum": 10.0,
            "title": "Trend Change Lookback Minutes"
          },
          "indicator_history_minutes": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 60.0,
            "title": "Indicator History Minutes"
          },
          "sr_strength_weights": {
            "$ref": "#/components/schemas/SRStrengthWeights"
          },
          "max_daily_loss_usd": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Max Daily Loss Usd"
          },
          "max_trades_per_day": {
            "type": "integer",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Trades Per Day"
          },
          "max_orders_per_minute": {
            "type": "integer",
            "maximum": 60.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Orders Per Minute"
          },
          "min_spread_bps": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Min Spread Bps"
          },
          "max_spread_bps": {
            "type": "integer",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Spread Bps"
          },
          "forbidden_tickers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Forbidden Tickers"
          },
          "earnings_blackout": {
            "type": "boolean",
            "title": "Earnings Blackout"
          },
          "halt_resume_cooldown_seconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Halt Resume Cooldown Seconds"
          },
          "no_new_entries_before_close_minutes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "No New Entries Before Close Minutes"
          },
          "force_flatten_before_close_minutes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Force Flatten Before Close Minutes"
          },
          "consecutive_losses_limit": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Consecutive Losses Limit"
          },
          "drawdown_pct_from_open": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Drawdown Pct From Open"
          },
          "entry_limit_cancel_seconds": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Entry Limit Cancel Seconds"
          },
          "config_reload_seconds": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Config Reload Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "account_equity_target_usd",
          "max_position_size_usd",
          "stop_loss_pct",
          "min_profit_per_trade_usd",
          "max_profit_per_trade_usd",
          "min_r_multiple",
          "max_commission_pct_of_target",
          "sr_strong_threshold",
          "sr_weak_threshold",
          "sr_partial_entry_pct",
          "sr_level_tolerance_pct",
          "sr_lookback_minutes",
          "sr_pivot_window",
          "trend_change_lookback_minutes",
          "indicator_history_minutes",
          "sr_strength_weights",
          "max_daily_loss_usd",
          "max_trades_per_day",
          "max_orders_per_minute",
          "min_spread_bps",
          "max_spread_bps",
          "earnings_blackout",
          "halt_resume_cooldown_seconds",
          "no_new_entries_before_close_minutes",
